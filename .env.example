# ==============================================================================
# Configuration du Proxy Auto-Start Minecraft (Crafty Controller v4)
# ==============================================================================

# Port public sur lequel le proxy écoute (le port habituel des joueurs Minecraft)
LISTEN_PORT=25565

# Port et hôte où tourne le vrai serveur Minecraft configuré dans Crafty
# (Astuce : dans Crafty, modifiez le server.properties pour écouter sur 25566)
TARGET_PORT=25566

# Hôte cible du serveur Minecraft :
# - Sous Docker avec extra_hosts (Dokploy) : utilisez host.docker.internal ou 172.17.0.1
# - Si en local ou network_mode host : utilisez 127.0.0.1
TARGET_HOST=host.docker.internal

# URL de l'API de votre instance Crafty Controller (avec protocole et port)
# - Passerelle Docker locale par défaut : https://172.17.0.1:8443
# - Avec extra_hosts dans docker-compose : https://host.docker.internal:8443
CRAFTY_URL=https://172.17.0.1:8443

# Jeton d'accès API généré dans Crafty Controller v4 (Paramètres > Utilisateurs & Tokens)
CRAFTY_TOKEN=votre_token_api

# Identifiant unique (UUID) du serveur Minecraft dans Crafty Controller
# Visible dans l'URL de votre serveur sur le panel Crafty : /panel/server_detail?id=XXXX-XXXX-...
CRAFTY_SERVER_ID=votre_uuid_serveur

# Action API Crafty à appeler (défaut : start_server ou start)
CRAFTY_ACTION=start_server

# MOTD affiché dans la liste des serveurs Minecraft quand Fabric est éteint
OFFLINE_MOTD=§c[Hors Ligne] §fRejoins pour démarrer le serveur

# Message affiché au joueur lorsqu'il clique pour se connecter alors que le serveur est éteint
# Supporte les sauts de ligne (\n) et les codes de couleur Minecraft (§)
DISCONNECT_MESSAGE=§a[AutoStart]\n§eOrdre de démarrage envoyé à Crafty !\n§fRéessaie dans 15 secondes le temps que Fabric charge.

# Durée minimale (en secondes) entre deux requêtes de démarrage à Crafty (anti-spam)
START_COOLDOWN_SEC=30

# Intervalle (en millisecondes) de détection de l'état du serveur Minecraft cible
CHECK_INTERVAL_MS=2000

# Mode en ligne pour le serveur factice de réception (false recommandé pour éviter les échecs d'auth Mojang hors ligne)
ONLINE_MODE=false
